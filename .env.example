# Copy this file to .env.local and fill in the values.
# Production values belong in the Vercel dashboard. Never commit real values.
# Routes that depend on a missing secret fail closed instead of using a default.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
# Must be the JWT-format service role key, not the public key
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
# Optional model overrides (defaults: gpt-4.1-mini for chat, gpt-4o-mini for helper calls)
OPENAI_CHAT_MODEL_V2=
OPENAI_CHAT_MODEL=

# --- Authentication (NextAuth with Google OAuth) ---
# NEXTAUTH_URL must be the production domain in production
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=

# --- Bearer secrets for automated routes ---
# Content ingestion endpoint (returns 503 when unset)
INGEST_SECRET=
# Scheduled jobs; scope to the Production environment in Vercel (returns 503 when unset)
CRON_SECRET=
# Development-only embedding repair endpoint
DEV_REPAIR_SECRET=

# --- Chat architecture (optional) ---
# Leave unset for the single-prompt default; set to v1 for RAG mode
CHAT_ARCHITECTURE=
# Allow a per-request architecture override in production (default: disabled)
CHAT_ARCH_OVERRIDE_ENABLED=

# --- Analytics and debugging (optional) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Set to 1 to show retrieval debug info in the chat UI
NEXT_PUBLIC_DEBUG_RAG=
NEXT_PUBLIC_DEBUG_RAG_TOGGLE=
